# =================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env)
# Copy file này thành .env để tùy chỉnh biến môi trường cục bộ.
# File .env đã được cấu hình trong .gitignore để không bao giờ bị commit lên Git.
# =================================================================

# 1. CẤU HÌNH DATABASE MYSQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/shoeshop_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_root_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# 2. CẤU HÌNH DỊCH VỤ AI FASTAPI
AI_SERVICE_URL=http://localhost:8000

# 3. CẤU HÌNH GOOGLE OAUTH2 LOGIN (Google Cloud Console)
# Truy cập https://console.cloud.google.com/apis/credentials để lấy keys
# Authorized Redirect URI: http://localhost/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
