# =================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env)
# Copy file này thành .env để tùy chỉnh biến môi trường cục bộ.
# File .env đã được cấu hình trong .gitignore để không bao giờ bị commit lên Git.
# =================================================================

# 1. CẤU HÌNH DATABASE MYSQL
# Dùng cho Docker Compose (tên host DB là ai-shoeshop-db, database: shoe_shopdb):
SPRING_DATASOURCE_URL=jdbc:mysql://ai-shoeshop-db:3306/shoe_shopdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Dùng khi chạy Spring Boot Local ngoài Docker (Port 3307):
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/shoe_shopdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=truonghoaiduoc5
MYSQL_ROOT_PASSWORD=truonghoaiduoc5

# 2. CẤU HÌNH DỊCH VỤ AI FASTAPI
# Dùng cho Docker Compose:
AI_SERVICE_URL=http://ai-shoeshop-engine:8000
# Dùng khi chạy Spring Boot Local ngoài Docker:
# AI_SERVICE_URL=http://localhost:8000

# 3. CẤU HÌNH GOOGLE OAUTH2 LOGIN (Google Cloud Console)
# Authorized Redirect URI: http://localhost/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

