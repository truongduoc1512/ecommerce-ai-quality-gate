{
    "info": {
        "_postman_id": "8f3b2a1c-9e4d-4c12-b5e0-8a7f6c5d4e3f",
        "name": "ShoeShop AI Quality Gate Service Test Suite",
        "description": "Comprehensive Postman API Collection with automated assertions for HTTP 200, 400, 500 status codes, JSON schema contract validation, and latency benchmarks (< 150ms).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Analyze Valid Product Image (200 OK)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 200 OK', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Response latency benchmark < 150ms', function () {",
                            "    pm.expect(pm.response.responseTime).to.be.below(150);",
                            "});",
                            "",
                            "pm.test('Response Payload Contract Schema Validation', function () {",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('approved');",
                            "    pm.expect(jsonData).to.have.property('status');",
                            "    pm.expect(jsonData).to.have.property('reason');",
                            "    pm.expect(jsonData).to.have.property('filename');",
                            "    pm.expect(jsonData).to.have.property('metrics');",
                            "    ",
                            "    const metrics = jsonData.metrics;",
                            "    pm.expect(metrics).to.have.property('blur_score');",
                            "    pm.expect(metrics).to.have.property('blur_threshold');",
                            "    pm.expect(metrics).to.have.property('is_blurry');",
                            "    pm.expect(metrics).to.have.property('max_object_ratio');",
                            "    pm.expect(metrics).to.have.property('min_object_ratio_required');",
                            "    pm.expect(metrics).to.have.property('is_cluttered');",
                            "    pm.expect(metrics).to.have.property('num_objects');",
                            "    pm.expect(metrics).to.have.property('detected_classes');",
                            "    pm.expect(metrics).to.have.property('image_size');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "file",
                            "type": "file",
                            "src": "test_shoe.jpg"
                        }
                    ]
                },
                "url": {
                    "raw": "http://localhost:8000/api/v1/analyze",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8000",
                    "path": [
                        "api",
                        "v1",
                        "analyze"
                    ]
                }
            }
        },
        {
            "name": "2. Upload Unsupported File Extension - .txt (400 Bad Request)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 400 Bad Request', function () {",
                            "    pm.response.to.have.status(400);",
                            "});",
                            "",
                            "pm.test('Returns explicit REJECTED status with localized reason', function () {",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData.approved).to.be.false;",
                            "    pm.expect(jsonData.status).to.eql('REJECTED');",
                            "    pm.expect(jsonData.reason).to.include('.txt');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "file",
                            "type": "file",
                            "src": "document.txt"
                        }
                    ]
                },
                "url": {
                    "raw": "http://localhost:8000/api/v1/analyze",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8000",
                    "path": [
                        "api",
                        "v1",
                        "analyze"
                    ]
                }
            }
        },
        {
            "name": "3. Upload Empty File Stream - 0 Bytes (400 Bad Request)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 400 Bad Request', function () {",
                            "    pm.response.to.have.status(400);",
                            "});",
                            "",
                            "pm.test('Returns REJECTED for 0 bytes file', function () {",
                            "    const jsonData = pm.response.json();",
                            "    pm.expect(jsonData.approved).to.be.false;",
                            "    pm.expect(jsonData.status).to.eql('REJECTED');",
                            "    pm.expect(jsonData.reason).to.include('0 bytes');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
